{
 "name": "hinged_plate",
 "units": "mm",
 "comment": "Hinged plate (from a hand sketch). Plate B, a by b, is hinged along its left edge to a fixed beam. A wire from the far right corner C runs over a snatch block at height h above the plate and carries the weight A. The rope leaves C on the tangent to the sheave and hangs vertically on the far side; the sheave turns into the plane of the rope. Sizes are estimates.",
 "params": {
  "a": 380,
  "b": 600,
  "t": 14,
  "h": 430,
  "dx": 190,
  "dy": 70,
  "R": 38,
  "r_rope": 2.5,
  "L_hang": 170
 },
 "derived": {
  "Cc": "vec(a, b, t)",
  "Pc": "vec(a + dx, b + dy, t + h)",
  "dh0": "vec(Cc[0] - Pc[0], Cc[1] - Pc[1], 0)",
  "D": "norm(dh0)",
  "dh": "dh0/D",
  "n": "cross(dh, vec(0, 0, 1))",
  "al": "arctan2(-h, D)",
  "be": "arccos(R/sqrt(D**2 + h**2))",
  "Hp": "Pc - R*dh",
  "Wt": "Hp - vec(0, 0, L_hang)",
  "rope": "[Cc] + [Pc + R*(cos(s)*dh + sin(s)*vec(0, 0, 1)) for s in linspace(al + be, pi, 9)] + [Wt]"
 },
